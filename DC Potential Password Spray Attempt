let lookback              = 1d;    
let authWindow            = 20m;   
let distinctAcctThreshold = 5;     
let setCap                = 100;  
let failureActionTypes    = dynamic(["LogonFailed"]);
let successActionTypes    = dynamic(["LogonSuccess"]);
let Logons =
    materialize(
        IdentityLogonEvents
        | where TimeGenerated >= ago(lookback)
        | where isnotempty(IPAddress)
        | where isnotempty(AccountUpn) or isnotempty(AccountName)
        | extend AccountKey = tolower(iif(isnotempty(AccountUpn),
                                          AccountUpn,
                                          strcat(AccountDomain, @"\", AccountName)))
        | where AccountKey !endswith "$"  
    );
let Breaches =
    Logons
    | where ActionType in (failureActionTypes)
    | summarize FailedAccountsInWindow = dcount(AccountKey, 4)
        by AuthWindow = bin(TimeGenerated, authWindow), IPAddress, Application
    | where FailedAccountsInWindow >= distinctAcctThreshold
    | summarize WindowThresholdBreaches     = count(),
                PeakFailedAccountsInWindow  = max(FailedAccountsInWindow)
        by IPAddress, Application;
let FailureRatio =
    Logons
    | summarize IpWideSuccessAccounts = dcountif(AccountKey, ActionType in (successActionTypes), 4),
                IpWideFailedAccounts  = dcountif(AccountKey, ActionType in (failureActionTypes), 4)
        by IPAddress
    | where IpWideFailedAccounts > IpWideSuccessAccounts;
let PerAccount =
    Logons
    | where ActionType in (failureActionTypes)
    | summarize FailuresForAccount = count() by IPAddress, Application, AccountKey
    | summarize FailuresByAccount      = make_bag(bag_pack(AccountKey, FailuresForAccount), setCap),
                MaxFailuresPerAccount  = max(FailuresForAccount),
                AvgFailuresPerAccount  = avg(FailuresForAccount)
        by IPAddress, Application
    | extend AvgFailuresPerAccount = round(AvgFailuresPerAccount, 1);
Logons
| where ActionType in (failureActionTypes)
| summarize StartTime            = min(TimeGenerated),
            EndTime              = max(TimeGenerated),
            FailedAccountCount   = dcount(AccountKey, 4),
            TotalFailures        = count(),
            TargetedAccounts     = make_set(AccountKey, setCap),
            TargetedDevices      = make_set(DestinationDeviceName, 50),
            SourceDeviceNames    = make_set(DeviceName, 20),
            Protocols            = make_set(Protocol, 20),
            LogonTypes           = make_set(LogonType, 20),
            FailureReasons       = make_set(FailureReason, 20),
            Locations            = make_set(coalesce(Location,"OnPrem"), 20)
    by IPAddress, Application
| join kind = inner Breaches     on IPAddress, Application
| join kind = inner PerAccount   on IPAddress, Application
| join kind = inner FailureRatio on IPAddress
| project StartTime,
          EndTime,
          IPAddress,
          TargetedApplication = Application,
          PeakFailedAccountsInWindow,
          WindowThresholdBreaches,
          MaxFailuresPerAccount,
          AvgFailuresPerAccount,
          TargetedAccounts,
          FailuresByAccount,
          TargetedDevices,
          SourceDeviceNames,
          Protocols,
          LogonTypes,
          FailureReasons,
          Locations,
          IpWideSuccessAccounts,
          FailureCounts = strcat("Total Failures: ",TotalFailures," | IP Wide Failures: ", IpWideFailedAccounts)
| extend TimeGenerated = StartTime 

